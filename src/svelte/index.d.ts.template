import type { Component, Snippet } from "svelte";
import type {
  AnchorOptions,
  BottomSheetEngine,
  CloseReason,
  EngineOptions,
  EngineState,
  MoveOutcome,
  SheetEventMap,
  SheetMode,
  SnapPoint,
  SnapPointDef,
  ScrimStagesOptions,
  ScrimUpdate,
  ScrimOverlayOptions,
} from "./index.js";

export type SvelteBottomSheetOpts<TId extends string = string> = Omit<
  EngineOptions,
  | "element"
  | "handle"
  | "scrollContainer"
  | "backdrop"
  | "scrim"
  | "snapPoints"
  | "allowed"
  | "initial"
> & {
  snapPoints: SnapPointDef<TId>[] | ReadonlyArray<SnapPointDef<TId>>;
  allowed?: TId[] | ReadonlyArray<TId>;
  initial?: TId;
  teleportTo?: string | HTMLElement | null;
  backdropColor?: string;
  backdropOpacity?: number;
  onSnap?: (id: TId) => void;
};

export type SvelteAttachRefs = {
  element: HTMLElement;
  handle?: HTMLElement;
  scrollContainer?: HTMLElement;
  backdrop?: HTMLElement;
  scrim?: HTMLElement;
};

export type SvelteBottomSheetController<TId extends string = string> = {
  attach(refs: SvelteAttachRefs): () => void;
  state(): EngineState & { activeId: TId };
  on<K extends keyof SheetEventMap>(
    event: K,
    fn: (payload: SheetEventMap[K]) => void,
  ): () => void;
  snapTo(id: TId): Promise<MoveOutcome>;
  open(id?: TId): Promise<MoveOutcome>;
  close(reason?: CloseReason): Promise<MoveOutcome>;
  expand(): Promise<MoveOutcome>;
  collapse(): Promise<MoveOutcome>;
  isTop(): boolean;
  depth(): number;
  setAllowed(ids: TId[], snap?: TId): void;
  setSnapPoints(points: EngineOptions["snapPoints"], allowed?: string[]): void;
  setScrim(opts: ScrimUpdate): void;
  setScrimOverlay(opts: ScrimOverlayOptions): () => void;
  addAnchor(opts: AnchorOptions): () => void;
  setScrimStages(opts: ScrimStagesOptions | null): () => void;
  recompute(): void;
  getEngine(): BottomSheetEngine | null;
  destroy(): void;
};

export function createBottomSheet<TId extends string = string>(
  opts: SvelteBottomSheetOpts<TId>,
): SvelteBottomSheetController<TId>;

export type BottomSheetProps<TId extends string = string> = Omit<
  Partial<EngineOptions>,
  | "element"
  | "handle"
  | "scrollContainer"
  | "backdrop"
  | "scrim"
  | "screenComponent"
  | "snapPoints"
  | "allowed"
  | "initial"
> & {
  snapPoints: SnapPointDef<TId>[];
  allowed?: TId[];
  initial?: TId;
  backdrop?: boolean;
  closeOnBackdrop?: boolean;
  teleport?: boolean;
  teleportTo?: string | HTMLElement | null;
  backdropColor?: string;
  backdropOpacity?: number;
  open?: boolean;
  snap?: TId;
  ariaLabel?: string;
  handleLabel?: string;
  contentLabel?: string;
  header?: Snippet<[EngineState & { activeId: TId }]>;
  footer?: Snippet<[EngineState & { activeId: TId }]>;
  anchors?: Array<
    Omit<AnchorOptions, "element"> & {
      content: Snippet<[EngineState & { activeId: TId }]>;
    }
  >;
  scrimStages?: Omit<ScrimStagesOptions, "stages"> & {
    stages: Array<
      Omit<ScrimStagesOptions["stages"][number], "element"> & {
        content: Snippet<[EngineState & { activeId: TId }]>;
      }
    >;
  };
  leftButton?: Snippet;
  rightButton?: Snippet;
  screen?: Snippet;
  children?: Snippet;
  onsnap?: (id: TId) => void;
  onbeforesnap?: (payload: SheetEventMap["before-snap"]) => void;
  onopen?: (id: TId) => void;
  onclose?: () => void;
  onbeforeclose?: (payload: SheetEventMap["before-close"]) => void;
  onopened?: (id: TId) => void;
  onclosed?: () => void;
  ondragstart?: (payload: SheetEventMap["dragstart"]) => void;
  ondragend?: (payload: SheetEventMap["dragend"]) => void;
  ondrag?: (payload: SheetEventMap["drag"]) => void;
  onprogress?: (payload: SheetEventMap["progress"]) => void;
  onchange?: (state: EngineState & { activeId: TId }) => void;
};

export type BottomSheetExports<TId extends string = string> = {
  snapTo(id: TId): Promise<MoveOutcome>;
  open(id?: TId): Promise<MoveOutcome>;
  close(reason?: CloseReason): Promise<MoveOutcome>;
  expand(): Promise<MoveOutcome>;
  collapse(): Promise<MoveOutcome>;
  isTop(): boolean;
  depth(): number;
  setAllowed(ids: TId[], snap?: TId): void;
  setSnapPoints(points: EngineOptions["snapPoints"], allowed?: string[]): void;
  setScrim(opts: ScrimUpdate): void;
  setScrimOverlay(opts: ScrimOverlayOptions): () => void;
  addAnchor(opts: AnchorOptions): () => void;
  setScrimStages(opts: ScrimStagesOptions | null): () => void;
  recompute(): void;
  setRadius(r: string | number): void;
  setMaxHeight(h: string | number): void;
  canDismiss(): boolean;
  getState(): EngineState & { activeId: TId };
  getEngine(): BottomSheetEngine | null;
};

export const BottomSheet: Component<
  BottomSheetProps,
  BottomSheetExports,
  "open" | "snap"
>;

export type {
  SnapPoint,
  SnapPointDef,
  SheetMode,
  EngineState,
  EngineOptions,
  MoveOutcome,
};
